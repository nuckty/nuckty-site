{
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "curly": [
            "error",
            "all"
        ],
        "no-control-regex": "off"
    },
    "ignorePatterns": [
        "**/node_modules/**",
        "**/.build/**",
        "site/**",
        "external/**",
        ".cache/**",
        "blocks/search/search-data.js"
    ]
}
